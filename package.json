{
  "name": "harness-foundry",
  "private": true,
  "type": "module",
  "description": "Practical, composable harness engineering for production agents.",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "foundry": "node packages/cli/dist/cli.js",
    "demo": "bash scripts/demo.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "harness-foundry",
    "harness-engineering",
    "agentic-engineering",
    "agent-runtime",
    "composable-primitives"
  ],
  "author": "Cobus Greyling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobusgreyling/harness-foundry.git"
  },
  "homepage": "https://github.com/cobusgreyling/harness-foundry#readme",
  "bugs": {
    "url": "https://github.com/cobusgreyling/harness-foundry/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.31.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "turbo": "^2.5.4",
    "typescript": "^6.0.3"
  }
}