{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-foundry.dev/schemas/harness-stack.json",
  "title": "HarnessStack",
  "type": "object",
  "required": ["name", "version", "layers"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "layers": {
      "type": "object",
      "properties": {
        "interface": { "type": "array", "items": { "$ref": "primitive-ref.json" } },
        "composition": { "type": "array", "items": { "$ref": "primitive-ref.json" } },
        "execution": { "type": "array", "items": { "$ref": "primitive-ref.json" } },
        "reliability": { "type": "array", "items": { "$ref": "primitive-ref.json" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}