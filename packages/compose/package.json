{
  "name": "@cobusgreyling/harness-foundry-compose",
  "version": "0.5.0",
  "description": "Compose harness stacks from declarative primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "catalog"
  ],
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');const p=require('path');const s=p.resolve('catalog');fs.rmSync(s,{recursive:true,force:true});fs.cpSync(p.resolve('../../primitives'),s,{recursive:true});\"",
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cobusgreyling/harness-foundry-core": "workspace:*",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}